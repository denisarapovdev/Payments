# --- API ---
API_KEY=dev-secret-api-key

# --- infrastructure (compose builds DATABASE_URL/RABBIT_URL from these; local runs default to localhost) ---
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
POSTGRES_DB=payments

# --- processing ---
MAX_ATTEMPTS=3
RETRY_BASE_DELAY=2
RETRY_MULTIPLIER=2
GATEWAY_SUCCESS_RATE=0.9
WEBHOOK_TIMEOUT=5
WEBHOOK_SECRET=dev-webhook-secret

# --- demo webhook receiver: 0.0 = always 200, 1.0 = always 503 ---
WEBHOOK_MOCK_FAIL_RATE=0

LOG_LEVEL=INFO
